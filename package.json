{
  "name": "hambuscador",
  "version": "0.1.0",
  "private": true,
  "description": "La picá hamburguesera de Chile — buscador, registro y rating de hamburgueserías a lo largo de todo Chile.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:postgis": "tsx scripts/run-sql.ts drizzle/postgis.sql",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-picas": "tsx scripts/seed-picas-lists.ts",
    "db:dedupe": "tsx scripts/dedupe-places.ts",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && pnpm db:push && pnpm db:postgis && pnpm db:seed"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@tabler/icons-react": "^3.24.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "maplibre-gl": "^5.24.0",
    "next": "^15.1.0",
    "next-auth": "5.0.0-beta.25",
    "pg": "^8.13.1",
    "pmtiles": "^4.4.1",
    "protomaps-themes-base": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.5.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.29.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}

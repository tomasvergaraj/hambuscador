# ==============================================================================
# Hambuscador — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# Nunca commitees `.env.local`.
# ==============================================================================

# URL pública del sitio (ej. https://hambuscador.cl en prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (Postgres + PostGIS)
# ------------------------------------------------------------------------------
# Para dev local: el docker-compose.yml de este repo. Levantarlo con `pnpm db:up`.
# Para prod: Neon, Supabase, o cualquier Postgres con extensión PostGIS.
DATABASE_URL=postgresql://hambuscador:hambuscador@localhost:5432/hambuscador

# ------------------------------------------------------------------------------
# Auth.js (next-auth v5)
# ------------------------------------------------------------------------------
# Generar con: `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth — credenciales en Google Cloud Console
# https://console.cloud.google.com/ → APIs & Services → Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL de callback (dejar vacío en dev, Auth.js infiere; setear en prod)
# AUTH_URL=https://hambuscador.cl

# ------------------------------------------------------------------------------
# Storage de fotos (Cloudflare R2)
# ------------------------------------------------------------------------------
# Setup:
# 1. Crear bucket en Cloudflare R2 dashboard
# 2. R2 → Manage R2 API Tokens → crear token con permisos Object Read + Write
# 3. Conectar dominio público (R2 → Settings → Public Access → Custom Domain)
# 4. Configurar CORS del bucket (permitir PUT desde el dominio del frontend):
#    [{"AllowedOrigins":["http://localhost:3000","https://hambuscador.cl"],
#      "AllowedMethods":["PUT","GET"],"AllowedHeaders":["*"]}]
# Sin estas vars seteadas, la app sigue funcionando pero los uploads de fotos
# muestran "modo demo: storage no configurado".
R2_ACCOUNT_ID=                                     # de Cloudflare dashboard URL
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hambuscador-photos
R2_PUBLIC_URL=https://photos.hambuscador.cl        # dominio público del bucket

# ------------------------------------------------------------------------------
# TODO Fase 3 — mapas (MapLibre + tiles)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.stadiamaps.com/styles/alidade_smooth.json
# NEXT_PUBLIC_STADIA_API_KEY=

# ------------------------------------------------------------------------------
# Email (Resend) — usado por el flow de recuperar contraseña
# ------------------------------------------------------------------------------
# Sin RESEND_API_KEY el email se loguea a console (no se envía).
# Sin RESEND_FROM_EMAIL cae a "Hambuscador <onboarding@resend.dev>" (sandbox
# de Resend: solo entrega al email dueño de la API key).
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Hambuscador <no-reply@hambuscador.cl>

# ------------------------------------------------------------------------------
# Analytics (opcional, recomendado Plausible)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hambuscador.cl
